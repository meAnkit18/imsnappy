# Do not put real values in this file. Configure secrets in Vercel and Render.

# Client (Vercel; VITE_ values are intentionally public)
VITE_API_BASE_URL=http://localhost:4100

# API (Render web service)
NODE_ENV=development
PORT=4100
MONGODB_URI=mongodb+srv://USER:PASSWORD@HOST/database?retryWrites=true&w=majority
JWT_ACCESS_SECRET=replace-with-a-long-random-value
JWT_REFRESH_SECRET=replace-with-a-different-long-random-value
CONFIG_ENCRYPTION_KEY=base64-encoded-32-byte-key
HARNESS_BASE_URL=http://localhost:4200
INTERNAL_SERVICE_TOKEN=replace-with-a-long-random-value
CLIENT_ORIGIN=http://localhost:3000
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
GROQ_API_KEY=your-groq-api-key

# Agent harness (Render private service)
PORT=4200
INTERNAL_SERVICE_TOKEN=must-match-the-API-INTERNAL_SERVICE_TOKEN
OPENCODE_API_KEY=server-side-only-provider-key
OPENCODE_BASE_URL=https://opencode.ai/zen/v1
E2B_API_KEY=server-side-only-sandbox-key
E2B_TEMPLATE=base
AGENT_MAX_TOOL_ROUNDS=4
AGENT_MAX_COMMAND_TIMEOUT_MS=60000
AGENT_REQUEST_TIMEOUT_MS=300000

# Orchestrator (Render background worker)
ORCHESTRATOR_POLL_INTERVAL_MS=30000
ORCHESTRATOR_LEASE_MS=900000
ORCHESTRATOR_MAX_ATTEMPTS=3
ORCHESTRATOR_MAX_BATCH_SIZE=20
HARNESS_BASE_URL=http://localhost:4200
INTERNAL_SERVICE_TOKEN=must-match-the-API-INTERNAL_SERVICE_TOKEN
MONGODB_URI=mongodb+srv://USER:PASSWORD@HOST/database?retryWrites=true&w=majority
MONGODB_DB_NAME=imsnappy
