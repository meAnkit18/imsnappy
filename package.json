{
  "name": "imsnappy-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:client": "pnpm --filter @imsnappy/client dev",
    "dev:api": "pnpm --filter @imsnappy/api dev",
    "dev:harness": "pnpm --filter @imsnappy/harness dev",
    "dev:orchestrator": "pnpm --filter @imsnappy/orchestrator dev",
    "build": "pnpm -r --if-present build",
    "check": "pnpm -r --if-present check",
    "test": "pnpm -r --if-present test",
    "format": "prettier --write \"{client,packages,services}/**/*.{ts,tsx,css,json,md}\" \"*.{json,md,yaml,yml}\"",
    "verify": "pnpm check && pnpm test"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "typescript": "^5.6.3"
  },
  "packageManager": "pnpm@10.15.1"
}
